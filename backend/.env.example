PORT=5000

# ========================================================
# MongoDB Database Configuration
# ========================================================
# Option 1: MongoDB Atlas (Recommended for cloud/dev)
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/luveo?retryWrites=true&w=majority
# NOTE: If your password contains special characters (@, #, :, /, %), URL-encode them (e.g. '@' -> '%40')
# NOTE: Ensure Network Access in MongoDB Atlas has 0.0.0.0/0 (Allow access from anywhere) enabled.

# Option 2: Local MongoDB (Requires mongod running locally on port 27017)
MONGO_URI=mongodb://localhost:27017/luveo

# ========================================================
# Authentication & Security
# ========================================================
JWT_SECRET=your_jwt_secret_key_min_32_characters_long
FRONT_END_URL=http://localhost:5173

# ========================================================
# Cloudinary (Media storage)
# ========================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ========================================================
# Payment & External Providers
# ========================================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://your-api-audience
NODE_ENV=development
